<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-2">
        <br> <br>
    <h3>Create a new Listing</h3>
    <form method="POST" action="/listings">
        <div class="mb-3">
            <lable for="title" class="form-lable">Title</lable>
        <input type="text" name="listing[title]" placeholder="Enter Title" class="form-control"/>
        </div>
        
        <div class="mb-3">
            <lable for="description" class="form-lable">Description</lable>
            <textarea type="text" name="listing[description]" placeholder="Enter Description" class="form-control"/>
        </textarea>
        </div>
        
        <div class="mb-3">
            <lable for="image" class="form-lable">Image Link</lable>
            <input name="listing[image]" type="text" placeholder="Enter Image URL" class="form-control"/>
        </div>

        <div class="row">
            <div class="mb-3 col-md-4">
             <lable for="price" class="form-lable">Price</lable>
             <input type="number" name="listing[price]" placeholder="Enter Price" class="form-control" />
        </div>

        <div class="mb-3 col-md-8"> 
            <lable for="country" class="form-lable">Country</lable>
            <input name="listing[country]" type="text" placeholder="Enter Country" class="form-control"/>
        </div>
        </div>
        
        
        <div class="mb-3">
            <lable for="location" class="form-lable">Location</lable>
            <input name="listing[location]" type="text" placeholder="Enter Location" class="form-control"/>
        </div>
        <button class="btn btn-dark add-btn">Add Listing</button>
        <br><br>
    </form>
    </div>
</div>