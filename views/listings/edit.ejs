<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-2">

    <h3>Edit your Listing</h3>
    <form method="POST" class="needs-validation" novalidate action="/listings/<%= listing.id %>?_method=PUT">
        <div class="mb-3">
            <lable for="title" class="form-lable">Title</lable>
            <input type="text" name="listing[title]" required value="<%= listing.title %>"class="form-control" />
            <div class="valid-feedback">Title looks good!</div>
        </div>
        
    

        <div class="mb-3">
            <lable for="description" class="form-lable">Description</lable>
            <textarea name="listing[description]" required class="form-control"><%= listing.description %></textarea>
            <div class="invalid-feedback">Please enter a short description</div>
        </div>

        
       

        <div class="mb-3">
            <lable for="image" class="form-lable">Image Link</lable>
            <input 
            type="text" 
            required 
            name="listing[image]" 
            value="<%= listing.image.url %>" 
            class="form-control"
            />

        </div>

        
       
        <div class="row">
            <div class="mb-3 col-md-4">
                <lable for="price" class="form-lable">Price</lable>
                <input type="number" required name="listing[price]" value="<%= listing.price %>" class="form-control"/>
                <div class="invalid-feedback">Enter a valid Price</div>
            </div>

            

            <div class="mb-3 col-md-8">
                <lable for="country" class="form-lable">Country</lable>
                <input type="text" required name="listing[country]" value="<%= listing.country %>" class="form-control"/>
                <div class="invalid-feedback">Enter a valid country</div>
            </div>
        </div>
        

        <div class="mb-3">
            <lable for="location" class="form-lable">Location</lable>
            <input type="text" required name="listing[location]" value="<%= listing.location %>" class="form-control"/>
            <div class="invalid-feedback">Enter a valid location</div>
        </div>

        
        <br><br>

        <button type="submit" class="btn btn-dark edit-btn">Edit</button>
        <br><br>
    </form>  
    </div>
</div>
<script src="/js/script.js"></script>